# =====================================================
# C2-App-116 — AI Quality Intelligence Platform
# Copy this file to .env at the repository root.
# Do NOT commit the real .env. Do NOT create per-folder .env files.
# =====================================================

# -----------------------------------------------------
# Cohort AI-usage logging (set by instructor — keep as-is)
# -----------------------------------------------------
DEFAULT_MODEL=claude-sonnet-4-20250514
LOG_LEVEL=INFO
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# -----------------------------------------------------
# Supabase (system of record)
# -----------------------------------------------------
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Required for pipeline ingest + alert writes (admin key — keep secret).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public vars exposed to the Vite frontend (app/)
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# -----------------------------------------------------
# LLM provider for spike analysis + cockpit chat agent
# Values: auto, openrouter, openai, gemini, groq, mock
# auto picks the first configured key: OpenRouter -> OpenAI -> Gemini -> Groq -> mock
# -----------------------------------------------------
LLM_PROVIDER=auto

OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/owl-alpha
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=AI Quality Intelligence Platform

OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# -----------------------------------------------------
# Pipeline run mode — DEMO/BATCH (chốt: batch thủ công, không real-time)
# Live stream is OFF by default. Demo = bấm nút chạy 1 lô 100-150 review.
# -----------------------------------------------------

# Streaming mode (luồng chính)
LIVE_STREAM_ENABLED=false
LIVE_STREAM_BATCH_SIZE=50
LIVE_STREAM_INTERVAL_SECONDS=5
LIVE_STREAM_LOOP=false
LIVE_STREAM_RESET_ON_START=false
AUTO_TICKET_ENABLED=true
AUTO_TICKET_EVERY_BATCHES=2
AUTO_TICKET_MAX_FEEDBACK=1000
AUTO_TICKET_MAX_SPIKES=6
# Ticket trigger: P5 tạo ngay; P4 cần cụm 3; P2/P3 cần volume 10;
# phản hồi tích cực tạo Marketing opportunity khi đủ 5 case.
TICKET_CRITICAL_THRESHOLD=1
TICKET_HIGH_RISK_THRESHOLD=3
TICKET_VOLUME_SPIKE_THRESHOLD=10
TICKET_MARKETING_SPIKE_THRESHOLD=5
TICKET_ALERT_COOLDOWN_MINUTES=60
AUTO_TICKET_WORKFLOW_ENABLED=true
AUTO_TICKET_IN_PROGRESS_AFTER_SECONDS=10
AUTO_TICKET_RESOLVED_AFTER_SECONDS=55
# Chu kỳ backend-worker quét chuyển trạng thái ticket. 15s = nhẹ CPU mà vẫn mượt
# (phải nhỏ hơn nhiều so với RESOLVED_AFTER_SECONDS để không trễ chuyển trạng thái).
WORKER_TICKET_WORKFLOW_INTERVAL_SECONDS=15

# ── Agent-worker (orchestrator chạy 6 agent nghiệp vụ mỗi WORKER_AGENT_INTERVAL_SECONDS) ──
WORKER_AGENT_ENABLED=true            # tắt cả cụm 6 agent (không redeploy)
WORKER_AGENT_INTERVAL_SECONDS=300    # chu kỳ chạy pipeline
WORKER_AGENT_HOURS=24                # cửa sổ feedback mỗi lượt
# Bật/tắt từng agent để cô lập debug hoặc tiết kiệm chi phí LLM (mặc định: bật)
AGENT_ALERT_ENABLED=true             # spike detection → ticket (gọi LLM analyze_spike)
AGENT_TASK_ENABLED=true              # gom cụm alert thành task
AGENT_INSIGHT_ENABLED=true           # tổng hợp metric theo phòng ban (không LLM)
AGENT_ANALYST_ENABLED=true           # root-cause phân tích sâu (gọi LLM, tốn nhất)
# AI-log: ghi vận hành 6 agent ra file JSONL (pipeline/agents/ai-log/YYYY-MM-DD.jsonl)
# Xem qua API: GET /api/agent/ai-log?limit=100&agent=router_agent (cần ops staff)
# Lưu ý: filesystem Railway ephemeral — log mất khi redeploy; nguồn bền là bảng agent_run_logs.
AI_LOG_ENABLED=true                  # =false để tắt file-log (vẫn ghi Supabase)
# AI_LOG_DIR=                        # override thư mục log (mặc định pipeline/agents/ai-log)


# Optional override for the dataset the pipeline ingests.
# Defaults to data/processed/seed_real_clean.json
# REAL_DATA_FILE=

# Backend API base used by the UI server functions.
BACKEND_API_URL=http://127.0.0.1:8000
VITE_BACKEND_API_URL=http://127.0.0.1:8000
