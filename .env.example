# =====================================================
# C2-App-116 — AI Quality Intelligence Platform
# Copy this file to .env at the repository root.
# Do NOT commit the real .env. Do NOT create per-folder .env files.
# =====================================================

# -----------------------------------------------------
# Cohort AI-usage logging (set by instructor — keep as-is)
# -----------------------------------------------------
DEFAULT_MODEL=claude-sonnet-4-20250514
LOG_LEVEL=INFO
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# -----------------------------------------------------
# Supabase (system of record)
# -----------------------------------------------------
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Required for pipeline ingest + alert writes (admin key — keep secret).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public vars exposed to the Vite frontend (app/)
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# -----------------------------------------------------
# LLM provider for spike analysis + cockpit chat agent
# Values: auto, openrouter, openai, gemini, groq, mock
# auto picks the first configured key: OpenRouter -> OpenAI -> Gemini -> Groq -> mock
# -----------------------------------------------------
LLM_PROVIDER=auto

OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/owl-alpha
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=AI Quality Intelligence Platform

OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# -----------------------------------------------------
# Pipeline run mode — DEMO/BATCH (chốt: batch thủ công, không real-time)
# Live stream is OFF by default. Demo = bấm nút chạy 1 lô 100-150 review.
# -----------------------------------------------------

# Streaming mode (luồng chính)
LIVE_STREAM_ENABLED=false
LIVE_STREAM_BATCH_SIZE=50
LIVE_STREAM_INTERVAL_SECONDS=1
LIVE_STREAM_LOOP=false
LIVE_STREAM_RESET_ON_START=false
AUTO_TICKET_ENABLED=true
AUTO_TICKET_EVERY_BATCHES=10
AUTO_TICKET_MAX_FEEDBACK=1000
AUTO_TICKET_MAX_SPIKES=1
AUTO_TICKET_WORKFLOW_ENABLED=true
AUTO_TICKET_IN_PROGRESS_AFTER_SECONDS=10
AUTO_TICKET_RESOLVED_AFTER_SECONDS=55


# Optional override for the dataset the pipeline ingests.
# Defaults to data/processed/seed_real_clean.json
# REAL_DATA_FILE=

# Backend API base used by the UI server functions.
BACKEND_API_URL=http://127.0.0.1:8000
VITE_BACKEND_API_URL=http://127.0.0.1:8000
