server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    # The Lookup code sits in /status/<code>; never send it on as a Referer.
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    # The app renders no HTML from data; this is the backstop. connect-src is the
    # backend baked into the bundle. 'unsafe-inline' styles: sonner injects a <style>.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' ${BACKEND_ORIGIN}; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    server_tokens off;

    # Hashed build assets never change under the same name.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # SPA fallback: /status/<code> and any other path get index.html.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
